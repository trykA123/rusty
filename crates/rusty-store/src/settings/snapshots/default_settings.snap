---
source: crates/rusty-store/src/settings/tests/snapshot.rs
expression: to_toml(&Settings::default())
---
[appearance]
mode = "system"
light-theme = "Ferrite Light"
dark-theme = "Ferrite Dark"
font = "Inter"
font-size = 13
density = "normal"
modifier-hints = "all"
modifier-hints-delay-ms = 400

[files]
hidden-files = "shown"
show-system = false
folders-first = true
sort = "name"
sort-descending = false

[selection]
space-measures-folders = true
patterns-select-folders = false

[terminal]
provider = "windows-terminal"

[editor]

[text.view]
line-numbers = true
line-ends = false

[image.view]
details = false

[automotive.view]
preset = "simple"
inspector = false
memory-strip = false
charts = false
row-bars = false

[experimental]
