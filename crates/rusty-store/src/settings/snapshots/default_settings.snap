---
source: crates/rusty-store/src/settings/tests/snapshot.rs
expression: to_toml(&Settings::default())
---
[appearance]
mode = "system"
light-theme = "Ferrite Light"
dark-theme = "Ferrite Dark"
font = "Inter"
font-size = 13
density = "normal"
modifier-hints = "all"
modifier-hints-delay-ms = 400

[files]
hidden-files = "shown"
show-system = false
folders-first = true
sort = "name"
sort-descending = false

[selection]
space-measures-folders = true
patterns-select-folders = false

[terminal]
provider = "windows-terminal"

[editor]

[window.view]
tabs-with-one = true
path-bar = true
drive-button = true
title-search = true
fkey-bar = false
icons = true
ext-column = true
size-column = true
date-column = true
free-space = true
marked-totals = true
contents = true

[text.view]
line-numbers = true
line-ends = false
syntax-theme = "oxidised-iron"

[image.view]
details = false

[markdown.view]
preview-split = true

[preview.view]
type-bars = true
largest-files = true

[copy]
mode = "auto"

[automotive.view]
preset = "simple"
inspector = false
memory-strip = false
charts = false
row-bars = false

[experimental]
