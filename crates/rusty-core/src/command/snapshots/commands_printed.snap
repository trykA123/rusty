---
source: crates/rusty-core/src/command/tests/snapshots.rs
expression: "lines.join(\"\\n\")"
---
pane.open-tab { location: "C:\\Users\\admin" }
pane.close-tab { tab: 2 }
pane.navigate { location: "/home/admin" }
pane.go-drive { root: "D:\\" }
pane.back
pane.forward
pane.refresh
pane.cursor-move { to: page-down }
pane.activate-tab { tab: 1 }
pane.scroll { to: 120 }
selection.toggle
selection.toggle-down
selection.range { to: 7 }
selection.extend { to: down, mode: toggle }
selection.extension { mark: true }
selection.restore
selection.add-pattern { pattern: "*.rs" }
selection.remove-pattern { pattern: "?.txt" }
selection.invert
selection.all
selection.clear
layout.split { direction: right }
layout.preset { tiles: "row(50, pane, pane)" }
layout.swap { a: 1, b: 4 }
layout.swap-toward { direction: left }
layout.resize { direction: right }
layout.ratio { split: root, ratio: 700 }
layout.even
layout.focus-pane { n: 4 }
layout.close
layout.focus { direction: up }
window.open { location: "D:\\Work" }
window.close { window: 3 }
window.focus { window: 1 }
workspace.switch { n: 2 }
workspace.new { name: "Project" }
workspace.rename { n: 1, name: "Work" }
workspace.move { n: 2, by: -1 }
workspace.delete { n: 2 }
workspace.restore
workspace.save
workspace.discard { n: 1 }
app.save-session
